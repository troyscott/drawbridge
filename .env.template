# =============================================================================
# Drawbridge Environment Configuration
# Shared across all cookbooks. Copy this file to .env and fill in your values:
#   cp .env.template .env
# =============================================================================

# --- Azure (required) ---
AZURE_SUBSCRIPTION_ID=           # Your Azure subscription ID
AZURE_LOCATION=eastus2           # Azure region (eastus, eastus2, westus2, etc.)

# --- Environment (optional, default shown) ---
ENV=dev                          # Environment: dev, staging, prod
                                 # Note: PROJECT is NOT set here — each cookbook
                                 # hardcodes its own PROJECT name in its config.sh
                                 # so multiple cookbooks never collide on the same
                                 # resource names.

# --- App Service (optional override, applies to every cookbook) ---
# ASP_SKU=B1                     # App Service Plan SKU (default: B1)

# =============================================================================
# cookbooks/dmz-app-sql overrides
# =============================================================================

# --- Tailscale (required for the subnet router in this cookbook) ---
TS_AUTHKEY=                      # Tailscale auth key (ephemeral, reusable)
                                 # Generate at: https://login.tailscale.com/admin/settings/keys

# --- Azure SQL (optional overrides) ---
# SQL_DB_SKU=GP_S_Gen5_2         # Serverless Gen5 2vCore (default)
# SQL_DB_AUTOPAUSE=60            # Auto-pause after N minutes idle (default: 60)

# --- Tailscale VM (optional overrides) ---
# TS_VM_SIZE=Standard_B1s        # VM size for subnet router (default: B1s ~$4/mo)

# --- Storage (optional overrides) ---
# STORAGE_SKU=Standard_LRS       # Storage redundancy (default: LRS)
# RANDOM_SUFFIX=abc123           # 6-char suffix for globally unique names (auto-generated if blank)
