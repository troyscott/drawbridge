# =============================================================================
# Drawbridge .gitignore
# =============================================================================

# --- Secrets and environment ---
.env
*.env.local
.env.*.local

# --- Tailscale ---
*.key
tailscale.state

# --- Terraform (future) ---
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Azure ---
.azure/

# --- Misc ---
*.log
*.tmp
